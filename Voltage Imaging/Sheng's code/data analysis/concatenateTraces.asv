figure;

plotIdx = 1;
for ind = [23 24 25 29]
    subplot(1, 1, plotIdx); plotIdx = plotIdx + 1;
    plot( resultConcat.df_trace(ind,:),'k','LineWidth',0.1); hold on;
    
    for div = 1:sessions
        plot([1 1].*div.*session_length,[-0 1.2],'Color',[0.7 0.7 0.7], 'LineWidth',1.5);hold on;
    end

    xlim([0 sessions*session_length]);ylim([0.7 1.2])

end

